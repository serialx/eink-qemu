{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb"],
    "externalBin": ["linux/binaries/eink-qemu"],
    "resources": {
      "linux/qemu/": "qemu/",
      "linux/native-dependencies.json": "native-dependencies.json"
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.35)", "libgcc-s1", "libgtk-3-0", "libwebkit2gtk-4.1-0",
          "libsdl2-2.0-0", "libx11-6", "libgcrypt20", "libglib2.0-0",
          "libpixman-1-0", "libpng16-16", "libslirp0", "zlib1g",
          "network-manager (>= 1.36)", "policykit-1", "init-system-helpers", "systemd"
        ],
        "files": {
          "/usr/lib/eink-qemu/bridge/": "linux/bridge/",
          "/usr/lib/systemd/system/eink-bridge.service": "../scripts/bridge/linux/eink-bridge.service",
          "/usr/share/polkit-1/actions/net.serialx.eink-qemu.bridge.policy": "../scripts/bridge/linux/net.serialx.eink-qemu.bridge.policy"
        },
        "preInstallScript": "../scripts/bridge/linux/maintainer.sh",
        "postInstallScript": "../scripts/bridge/linux/maintainer.sh",
        "preRemoveScript": "../scripts/bridge/linux/maintainer.sh",
        "postRemoveScript": "../scripts/bridge/linux/maintainer.sh"
      }
    }
  }
}
